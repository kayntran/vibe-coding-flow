# Allowlist: chặn tất cả, chỉ mở đúng phần flow. Thêm file mới ⇒ thêm dòng "!" ở đây.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/install.mjs
!/CLAUDE.md
!/WORKERS.md
!/WORKTREE.md

!/.claude/
/.claude/*
!/.claude/allow-direct-edit

!/agents/
!/hooks/
/hooks/*.log

!/workers/

!/skills/
/skills/*
!/skills/flow-*/

!/plans/
/plans/*
!/plans/flow-v2.md
!/plans/flow-v2-hooks-spec.md
!/plans/flow-v3-hooks-spec.md
!/plans/flow-v4-parallel-spec.md
!/plans/flow-v5-hooks-spec.md
!/plans/flow-v6-so-chot/
/plans/flow-v6-so-chot/*
!/plans/flow-v6-so-chot/*.md
